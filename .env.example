# A-Share Hunter 环境变量示例
# 复制为 .env 后按实际情况填写

# Futu OpenD
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_MAX_PLATE_REFRESH_PER_RUN=10
FUTU_PLATE_CACHE_DAYS=7
FUTU_REQUEST_INTERVAL=0.60

# 扫描筛选
TOP_SECTORS=10
TOP_STOCKS=30
MIN_AMOUNT_YUAN=50000000

# 财务 / 估值 / 新闻 / 资金 Agent 取数配置
FINANCIAL_REPORT_COUNT=5
VALUATION_INTERVAL=YEAR_5
NEWS_MAX_COUNT=20
CAPITAL_FLOW_DAYS=10

# 决策 Agent 维度权重（0-1）
DECISION_WEIGHT_FINANCIAL=0.25
DECISION_WEIGHT_VALUATION=0.25
DECISION_WEIGHT_NEWS=0.15
DECISION_WEIGHT_CAPITAL=0.20
DECISION_WEIGHT_TECHNICAL=0.15

# 可选 LLM 总结（默认关闭）
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 调试日志（设为 DEBUG 可查看每次 Futu 调用、参数摘要、耗时与完整堆栈）
# 写入文件的级别，调试时改 DEBUG
LOG_LEVEL=INFO
# 控制台级别
LOG_CONSOLE_LEVEL=INFO
# GUI「运行日志」面板级别
LOG_GUI_LEVEL=INFO
# 第三方库（futu/langchain/urllib3 等）噪音级别
LOG_THIRD_PARTY_LEVEL=WARNING
LOG_FILE=output/logs/investmind.log
# 单个日志文件 5MB，滚动保留 3 份
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# 美股研究（全市场板块扫描，与 A 股链路对称）
US_TOP_SECTORS=10
US_TOP_STOCKS=30
US_MIN_AMOUNT_USD=10000000
# 剔除 OTC 粉单等无行情权限标的，避免 get_market_snapshot 整批失败（默认 true）
US_EXCLUDE_OTC=true
# 快照单批代码数，富途上限 400；遇整批失败可调小（如 100）
US_SNAPSHOT_BATCH_SIZE=400
